numbers = []
n = int(input("Number of elements: "))


for i in range(n):
    value = int(input(f"Element {i + 1}: "))
    numbers.append(value)

average = sum(numbers) / len(numbers) if numbers else 0

print(f"Array: {numbers}")
print(f"Sum: {sum(numbers)}")
print(f"Average: {average}")
